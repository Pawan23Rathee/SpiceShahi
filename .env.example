# Server Port
PORT=3000

# Transactional Email System (SpiceShahi Official Email Configuration)
FROM_EMAIL=contact@spiceshahi.in
FROM_NAME=SpiceShahi
ADMIN_NOTIFICATION_EMAIL=contact@spiceshahi.in

# SMTP Relay Configuration (Optional for live delivery; simulated dispatch and disk audit log active if empty)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# Razorpay Online Payment Integration (Optional for local testing; simulated verified gateway active if empty)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Secure Admin Dashboard Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=SpiceShahi@2026
ADMIN_SECRET=spiceshahi-super-secret-jwt-key-2026

# Customer Authentication Secret
CUSTOMER_SECRET=spiceshahi-customer-jwt-secret-2026

# Server-Side Gemini API Key (if AI features are used)
GEMINI_API_KEY=

# Feature Flags
# Temporarily disabled (false) during testing. Set to 'true' to re-enable WhatsApp UI across the site.
VITE_ENABLE_WHATSAPP=false
ENABLE_WHATSAPP=false
